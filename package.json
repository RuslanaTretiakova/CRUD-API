{
  "name": "rs-crud-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:dev": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "start:multi": "cross-env NODE_ENV=production node dist/cluster.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "lint": "eslint",
    "format": "prettier -w ."
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
